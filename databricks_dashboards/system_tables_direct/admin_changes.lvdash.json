{
  "datasets": [
    {
      "name": "dbdffde7",
      "displayName": "Admin changes: who changed groups, roles, grants and settings",
      "queryLines": [
        "SET QUERY_TAGS['cost_center'] = 'lakehouse_health';\n",
        "SET QUERY_TAGS['domain'] = 'lakehouse_health';\n",
        "SET QUERY_TAGS['dashboard'] = 'admin_changes';\n",
        "SET QUERY_TAGS['tab'] = 'admin_changes';\n",
        "-- Admin changes: who changed groups, roles, grants and settings. Dates from the Time Window.\n",
        "WITH ws AS (\n",
        "  SELECT CAST(workspace_id AS STRING) AS workspace_id, workspace_name\n",
        "  FROM system.access.workspaces_latest\n",
        "),\n",
        "actions AS (\n",
        "  SELECT * FROM VALUES ('accounts', 'addPrincipalToGroup', 'Group membership'),\n",
        "         ('accounts', 'addPrincipalsToGroup', 'Group membership'),\n",
        "         ('accounts', 'removePrincipalFromGroup', 'Group membership'),\n",
        "         ('accounts', 'removePrincipalsFromGroup', 'Group membership'),\n",
        "         ('accounts', 'createGroup', 'Groups'),\n",
        "         ('accounts', 'removeGroup', 'Groups'),\n",
        "         ('accounts', 'updateGroup', 'Groups'),\n",
        "         ('accounts', 'setAdmin', 'Admin role'),\n",
        "         ('accounts', 'removeAdmin', 'Admin role'),\n",
        "         ('accounts', 'setAccountAdmin', 'Admin role'),\n",
        "         ('accounts', 'removeAccountAdmin', 'Admin role'),\n",
        "         ('accountsManager', 'changeAccountOwner', 'Admin role'),\n",
        "         ('workspace', 'updateRoleAssignment', 'Workspace access'),\n",
        "         ('workspace', 'addPermissionAssignment', 'Workspace access'),\n",
        "         ('workspace', 'updatePermissionAssignment', 'Workspace access'),\n",
        "         ('workspace', 'deletePermissionAssignment', 'Workspace access'),\n",
        "         ('unityCatalog', 'updatePermissions', 'Grants (Unity Catalog)'),\n",
        "         ('unityCatalog', 'updateSharePermissions', 'Grants (Unity Catalog)'),\n",
        "         ('accounts', 'changeDatabricksSqlAcl', 'Permissions (ACL)'),\n",
        "         ('accounts', 'changeDatabricksWorkspaceAcl', 'Permissions (ACL)'),\n",
        "         ('accounts', 'changeDatabricksWorkspaceDirectoryAcl', 'Permissions (ACL)'),\n",
        "         ('accounts', 'changeServicePrincipalAcls', 'Permissions (ACL)'),\n",
        "         ('workspace', 'changeWorkspaceAcl', 'Permissions (ACL)'),\n",
        "         ('accountsAccessControl', 'updateRuleSet', 'Permissions (ACL)'),\n",
        "         ('clusterPolicies', 'create', 'Cluster policies'),\n",
        "         ('clusterPolicies', 'edit', 'Cluster policies'),\n",
        "         ('clusterPolicies', 'delete', 'Cluster policies'),\n",
        "         ('clusterPolicies', 'changeClusterPolicyAcl', 'Cluster policies'),\n",
        "         ('workspace', 'workspaceConfEdit', 'Settings'),\n",
        "         ('workspace', 'setSetting', 'Settings'),\n",
        "         ('workspace', 'deleteSetting', 'Settings'),\n",
        "         ('accounts', 'setSetting', 'Settings'),\n",
        "         ('accounts', 'deleteSetting', 'Settings')\n",
        "    AS a(service_name, action_name, category)\n",
        "),\n",
        "ev AS (\n",
        "  SELECT e.event_time, CAST(e.workspace_id AS STRING) AS workspace_id, e.service_name, e.action_name, a.category,\n",
        "         COALESCE(e.user_identity.email, e.user_identity.subject_name) AS actor,\n",
        "         e.response.status_code AS status_code,\n",
        "         -- what was changed: the object, or user -> group; the keys differ by action\n",
        "         COALESCE(e.request_params['securable_full_name'],\n",
        "                  CASE WHEN e.request_params['targetGroupName'] IS NOT NULL\n",
        "                       THEN concat(COALESCE(e.request_params['targetUserName'], e.request_params['targetUserId'], '?'), ' -> ',\n",
        "                                   e.request_params['targetGroupName']) END,\n",
        "                  e.request_params['targetUserName'], e.request_params['targetUserId'], e.request_params['groupName'], e.request_params['name'],\n",
        "                  e.request_params['principal'], e.request_params['resourceId'], e.request_params['policy_id'], e.request_params['workspaceConfKeys'], '-') AS target,\n",
        "         e.request_params['changes'] AS changes\n",
        "  FROM system.access.audit e\n",
        "  JOIN actions a ON a.service_name = e.service_name AND a.action_name = e.action_name\n",
        "  WHERE e.event_date >= CAST(:time_range.min AS DATE) AND e.event_date < date_add(:time_range.max, 1)\n",
        "  QUALIFY ROW_NUMBER() OVER (PARTITION BY e.event_id ORDER BY e.event_time DESC) = 1\n",
        ")\n",
        "SELECT CAST(event_time AS STRING) AS changed_at, CAST(event_time AS DATE) AS day,\n",
        "       CASE WHEN e.workspace_id = '0' THEN 'Account' ELSE COALESCE(ws.workspace_name, e.workspace_id) END AS workspace, category, action_name AS action, target,\n",
        "       left(changes, 300) AS change, actor, CASE WHEN actor RLIKE '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$' THEN 'Service principal' WHEN actor LIKE '%@%' THEN 'User' WHEN actor IS NULL THEN 'Unknown' ELSE 'Other (system)' END AS actor_type, 1 AS changes_count,\n",
        "       CASE WHEN status_code = 200 THEN 'Done' WHEN status_code IS NULL THEN 'Unknown' ELSE 'Failed' END AS outcome,\n",
        "       CASE WHEN actor LIKE '%@%' THEN 1 ELSE 0 END AS by_user\n",
        "FROM ev e\n",
        "LEFT JOIN ws ON ws.workspace_id = e.workspace_id\n",
        "ORDER BY event_time DESC\n"
      ],
      "parameters": [
        {
          "displayName": "time_range",
          "keyword": "time_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now-1d/d"
              }
            }
          }
        }
      ]
    }
  ],
