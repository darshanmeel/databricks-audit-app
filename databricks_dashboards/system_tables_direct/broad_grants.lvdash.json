{
  "datasets": [
    {
      "name": "37e55536",
      "displayName": "Grants: every privilege granted in Unity Catalog, broad ones flagged",
      "queryLines": [
        "SET QUERY_TAGS['cost_center'] = 'lakehouse_health';\n",
        "SET QUERY_TAGS['domain'] = 'lakehouse_health';\n",
        "SET QUERY_TAGS['dashboard'] = 'broad_grants';\n",
        "SET QUERY_TAGS['tab'] = 'broad_grants';\n",
        "-- Grants: every privilege granted in Unity Catalog, broad ones flagged. Dates from the Time Window.\n",
        "WITH ws AS (\n",
        "  SELECT CAST(workspace_id AS STRING) AS workspace_id, workspace_name\n",
        "  FROM system.access.workspaces_latest\n",
        "),\n",
        "ev AS (\n",
        "  SELECT event_id, event_time, CAST(workspace_id AS STRING) AS workspace_id,\n",
        "         COALESCE(user_identity.email, user_identity.subject_name) AS actor,\n",
        "         upper(request_params['securable_type']) AS object_type,\n",
        "         request_params['securable_full_name'] AS object,\n",
        "         request_params['changes'] AS changes\n",
        "  FROM system.access.audit\n",
        "  WHERE service_name = 'unityCatalog' AND action_name = 'updatePermissions'\n",
        "    AND response.status_code = 200\n",
        "    AND event_date >= CAST(:time_range.min AS DATE) AND event_date < date_add(:time_range.max, 1)\n",
        "  QUALIFY ROW_NUMBER() OVER (PARTITION BY event_id ORDER BY event_time DESC) = 1\n",
        "),\n",
        "per_grantee AS (\n",
        "  SELECT ev.*, explode(from_json(changes, 'ARRAY<STRUCT<principal: STRING, add: ARRAY<STRING>, remove: ARRAY<STRING>>>')) AS c\n",
        "  FROM ev\n",
        "),\n",
        "granted AS (\n",
        "  SELECT event_time, workspace_id, actor, object_type, object, c.principal AS grantee,\n",
        "         upper(replace(p, ' ', '_')) AS privilege\n",
        "  FROM per_grantee\n",
        "  LATERAL VIEW explode(c.add) x AS p\n",
        "),\n",
        "judged AS (\n",
        "  SELECT g.*,\n",
        "         g.privilege = 'ALL_PRIVILEGES' AND g.object_type IN ('CATALOG', 'SCHEMA', 'TABLE') AS all_privileges,\n",
        "         lower(g.grantee) = 'account users' AS to_account_users\n",
        "  FROM granted g\n",
        ")\n",
        "SELECT CAST(event_time AS STRING) AS granted_at, CAST(event_time AS DATE) AS day,\n",
        "       CASE WHEN j.workspace_id = '0' THEN 'Account' ELSE COALESCE(ws.workspace_name, j.workspace_id) END AS workspace, object_type, object, privilege, grantee, actor,\n",
        "       CASE WHEN actor RLIKE '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$' THEN 'Service principal' WHEN actor LIKE '%@%' THEN 'User' WHEN actor IS NULL THEN 'Unknown' ELSE 'Other (system)' END AS actor_type, 1 AS grants,\n",
        "       CASE WHEN all_privileges AND to_account_users THEN 'All privileges to account users'\n",
        "            WHEN all_privileges THEN 'All privileges'\n",
        "            WHEN to_account_users THEN 'To account users' ELSE 'Not broad' END AS why,\n",
        "       CASE WHEN all_privileges OR to_account_users THEN 1 ELSE 0 END AS critical\n",
        "FROM judged j\n",
        "LEFT JOIN ws ON ws.workspace_id = j.workspace_id\n",
        "ORDER BY critical DESC, event_time DESC\n"
      ],
      "parameters": [
        {
          "displayName": "time_range",
          "keyword": "time_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now-1d/d"
              }
            }
          }
        }
      ]
    }
  ],
