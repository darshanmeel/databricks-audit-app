# Copy to .env and fill in the three values. Used by the export (tools/first_run.py, Refresh in
# the app) and tools/snapshot.py, the only steps that talk to Databricks.
# .env is git-ignored. Never commit it or paste its contents anywhere. There is no --token flag
# anywhere in this repo by design.
#
# No quotes, no spaces around the '='.

# Workspace host, without https:// and without a trailing slash.
#   e.g. dbc-1a2b3c4d-5e6f.cloud.databricks.com   (AWS)
#        adb-1234567890123456.7.azuredatabricks.net   (Azure)
DATABRICKS_SERVER_HOSTNAME=dbc-xxxxxxxx-xxxx.cloud.databricks.com

# HTTP path of the SQL warehouse to run the export through.
# SQL Warehouses -> your warehouse -> Connection details -> HTTP path.
#   e.g. /sql/1.0/warehouses/abc123def456
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxx

# Personal access token with SELECT on system.* (Settings -> Developer -> Access tokens).
# Read-only is enough: the exporter never writes to the workspace.
DATABRICKS_TOKEN=dapi-your-token-here
